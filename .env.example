# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_KEY_SUPABASE=
NEXT_PRIVATE_KEY_SUPABASE=

# Supabase — Account > Access Tokens (perso, CLI/Management API uniquement)
NEXT_ACCESS_TOKEN_SUPABASE=

# Compte e2e fixe pour Playwright (ADR-04) — créer un utilisateur dédié dans Supabase Auth
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Compte e2e dédié à l'onboarding (US-29) — recréé à chaque run (signup), supprimé en amont
E2E_ONBOARDING_EMAIL=
E2E_ONBOARDING_PASSWORD=

# Guide utilisateur (issue #68) — sync Notion → build, base "Guide Dodojo".
# NOTION_DATABASE_ID a un défaut hardcodé dans scripts/pull-guide.mjs, override optionnel ici.
NOTION_TOKEN=

# Web Push (US-11) — clés VAPID, générées une fois via
# `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@dodojo.app

# Inngest (US-11 refactor — issues #102 #114)
# Dashboard : https://app.inngest.com (palier Hobby free tier, $0,
# 50K "executions"/mois — 1 execution = 1 run + chaque step à l'intérieur,
# PAS de schedule illimité comme affirmé auparavant : ce concept n'existe
# même pas dans le SDK, cf. docs/superpowers/plans/2026-07-30-push-inngest-migration.md).
# Consommation estimée : reminder-fanout (cron */15, 96 runs/jour × ~3
# executions) + send-reminder (~4 executions par profil éligible et par
# jour) — largement dans le palier gratuit à l'échelle de ce projet.
# Créer l'app "dodojo", puis récupérer les clés depuis Settings > Keys
# (normalement provisionnées automatiquement par l'intégration Vercel).
INNGEST_APP_ID=dodojo
# Signing key vide = dev local accepté (avec INNGEST_DEV=1) ; OBLIGATOIRE
# en production, sans quoi /api/inngest accepte des requêtes non signées.
INNGEST_SIGNING_KEY=
# Event key pour envoyer des events à Inngest (fan-out → push/send-reminder).
INNGEST_EVENT_KEY=

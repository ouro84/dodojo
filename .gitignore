# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/
.superpowers/

# graphify — graphe régénérable via `graphify update .`, pas une source de vérité
/graphify-out/

# assets bruts (packs tiers, licences mixtes, non versionnés — voir ASSETS.md)
/assets/

.worktrees/

# impeccable — design.json (sidecar DESIGN.md) est versionné, son cache local ne l'est pas
.impeccable/hook.cache.json
